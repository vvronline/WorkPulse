# infra/livekit/.env.example
#
# Copy the relevant values into the Railway service's Variables tab, or into
# a local infra/livekit/.env for `docker compose up` / validate.ps1. Never
# commit real values — this file only documents names/shapes.

# --- Required in every environment ------------------------------------------
# Any non-empty API key/secret pair (LiveKit does not validate their format);
# generate with e.g. `openssl rand -hex 16` / `openssl rand -hex 32`.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Railway private Redis URL, e.g. ${{Redis.REDIS_URL}} when referenced from
# another Railway service, or redis://default:PASSWORD@host:6379 directly.
# Must be the private/internal URL — do not route this over the public net.
REDIS_URL=

# --- Required on Railway (set LIVEKIT_LOCAL_DEV=true to skip these locally) -
# PORT is injected automatically once a public domain is generated for this
# service (Settings -> Networking -> Generate Domain).
PORT=
# RAILWAY_TCP_PROXY_DOMAIN / RAILWAY_TCP_PROXY_PORT / RAILWAY_TCP_APPLICATION_PORT
# are injected automatically once a TCP Proxy is attached to this service
# (Settings -> Networking -> TCP Proxy, application port 7881). You must
# redeploy after adding the proxy for these to appear. See README.md.
RAILWAY_TCP_PROXY_DOMAIN=
RAILWAY_TCP_PROXY_PORT=
RAILWAY_TCP_APPLICATION_PORT=

# --- Optional ----------------------------------------------------------------
# Pin an explicit node IP instead of STUN-based auto external-IP detection.
# LIVEKIT_NODE_IP=
# debug | info | warn | error (default: info)
# LIVEKIT_LOG_LEVEL=info
# Set to "true" ONLY for non-Railway local docker/docker-compose runs — it
# relaxes the PORT + TCP-proxy-variable checks in entrypoint.sh. Never set
# this on Railway.
# LIVEKIT_LOCAL_DEV=false
