node_modules/
dist/
build/

# ── Expo / React Native (mobile) ──────────────────────
# Expo dev cache. The mobile/ workspace has its own .gitignore covering its
# generated native projects (/android, /ios), .expo/, dist/, keystores, etc.,
# but a root-level .expo/ can appear if expo tooling is run from the repo root.
.expo/
**/.expo/

# Local AI assistant settings (committed docs like CLAUDE.md/AGENTS.md are kept,
# but the per-tool settings dir is local-only)
.claude/
**/.claude/

# Scratch / debug files
apkcheck.txt
r.txt

*.db
*.db-shm
*.db-wal
*.log
server-log.txt
server-output.log
client/dist/
# Generated at build time by client/scripts/copy-mediapipe.mjs from
# node_modules/@mediapipe/selfie_segmentation. Don't commit the ~12 MB
# of WASM/model binaries — npm is the source of truth.
client/public/mediapipe/

# Generated at build time by client/scripts/copy-face-models.mjs from the
# @vladmandic/face-api CDN. Don't commit the ~7 MB of model weights —
# the script downloads them on demand.
client/public/models/
server/uploads/
server/data/
data/
.vite/
coverage/

# ── Environment / secrets ─────────────────────────────
# Google geolocation API key (injected at build time from CI secrets)
desktop/google-api-key.txt

# All real .env files (and any per-tier variant) MUST stay local.
# Only `.env.example` (no secrets) belongs in git.
.env
.env.*
!.env.example
!**/.env.example
**/.env
**/.env.*
!**/.env.example

# Local development config (not for production)
.env.dev
docker-compose.dev.yml
Caddyfile.dev

# ── coturn deployment (infra/coturn) ──────────────────
# Never commit the runtime turnserver.conf (it has the static-auth-secret
# substituted in), TLS certs, or the per-environment .env file.
infra/coturn/.env
infra/coturn/certs/
infra/coturn/turnserver.runtime.conf
*.pem
*.key
!infra/coturn/turnserver.conf

# ── Universal local/editor artifacts ────────────────────
Thumbs.db
*.tmp
*.swp
.vscode/
.idea/
