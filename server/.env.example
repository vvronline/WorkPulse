JWT_SECRET=your_jwt_secret_here

# ── Database ──────────────────────────────────────────
# DATABASE_URL=postgresql://user:pass@localhost:5432/workpulse
# DIRECT_DATABASE_URL=postgresql://user:pass@postgres:5432/workpulse  # bypass PgBouncer for migrations
# MASTER_POOL_SIZE=4
# TENANT_POOL_SIZE=3
# TENANT_MAX_POOLS=100
# TENANT_FOREACH_CONCURRENCY=5

# ── Process role / serving ───────────────────────────────────
# ROLE=all                 # all | web | realtime | worker
# SERVE_SPA=true           # set false after Cloudflare/R2 SPA cutover

# ── Redis (required in production) ───────────────────────────
# REDIS_URL=redis://:password@redis.railway.internal:6379

# ── Private uploads (Cloudflare R2) ──────────────────────────
# STORAGE_DRIVER=local     # production MUST use r2
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_UPLOADS_BUCKET=aino-uploads

# ── Observability (Phase H) ──────────────────────────────────
# Prometheus scrape endpoint: GET /metrics on every role.
# FAIL-CLOSED: with METRICS_TOKEN unset, /metrics returns 404 in production and
# is open in development. Set the SAME value on every service, or dashboards
# will show gaps that look like outages.
# METRICS_TOKEN=            # openssl rand -base64 32
# METRICS_TENANT_TOP_N=20   # tenants with their own label; the rest fold into `other`
# METRICS_TENANT_REFRESH_MS=60000
#
# OpenTelemetry tracing is OPT-IN: it starts only when the endpoint is set.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://collector:4318
# OTEL_EXPORTER_OTLP_HEADERS=authorization=Bearer <token>

# ── Email ─────────────────────────────────────────────
# Required for notifications, password reset, etc.
# Two modes supported — set one group or the other:

# MODE 1 — Gmail OAuth2 (recommended, token-based, no password stored)
# See setup guide: https://developers.google.com/identity/protocols/oauth2
# 1. Create OAuth credentials at https://console.cloud.google.com/apis/credentials
# 2. Get a refresh token via OAuth2 Playground (https://developers.google.com/oauthplayground)
SMTP_USER=your-email@gmail.com
GMAIL_CLIENT_ID=your-client-id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your-client-secret
GMAIL_REFRESH_TOKEN=your-refresh-token
SMTP_FROM="WorkPulse" <your-email@gmail.com>

# MODE 2 — Plain SMTP (app-password fallback)
# For Gmail: enable 2FA, then create App Password at https://myaccount.google.com/apppasswords
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM="WorkPulse" <your-email@gmail.com>

# ── CORS ──────────────────────────────────────────────
# Comma-separated list of exact origins allowed to call the API.
# Production (AINO): https://aino.org.in,https://www.aino.org.in
# NOTE: keep the Railway origin (https://workpulse-prod.up.railway.app) reachable
# too -- installed desktop/mobile builds still point at it. Same-origin requests
# are always allowed via the Host header, so it need not be listed here.
# CORS_ORIGIN=http://localhost:3000

# ── WebAuthn / passkeys ─────────────────────────────
# LEAVE BOTH UNSET unless you know you need them.
#
# A passkey is cryptographically bound to the rpID (the registrable domain) it
# was created under, and that binding CANNOT be migrated. Setting WEBAUTHN_RP_ID
# to a new domain instantly invalidates every existing passkey — all users must
# re-enrol biometric sign-in.
#
# Unset, server/routes/auth.ts derives rpID from the REQUEST hostname. That is
# what you want during the AINO domain move: passkeys registered on
# workpulse-prod.up.railway.app keep working there, and passkeys created on
# aino.org.in bind to the new domain — both valid, no flag day.
# WEBAUTHN_RP_ID=aino.org.in
# WEBAUTHN_ORIGIN=https://aino.org.in

# ── Desktop (Electron) cross-site cookie ──────────────
# Custom-protocol origins allowed to receive a SameSite=None auth cookie.
# Defaults to "workpulse://,aino://" so both the installed and rebranded desktop
# builds work. If you override this, keep BOTH schemes listed until the legacy
# desktop build is fully retired.
# DESKTOP_COOKIE_ORIGINS=workpulse://,aino://

# ── WebRTC: STUN / TURN ───────────────────────────────
# WorkPulse audio/video calls and meetings traverse NATs/firewalls using
# STUN + TURN. Pick ONE of the three options below.
#
# OPTION A — Cloudflare Calls (recommended for Railway / serverless deploys)
# Free 1 TB/month. Sign up at https://dash.cloudflare.com → Calls → TURN App.
# Just set these two; the server mints short-lived creds via the Cloudflare API.
# CLOUDFLARE_TURN_TOKEN_ID=<your-cloudflare-turn-token-id>
# CLOUDFLARE_TURN_API_TOKEN=<your-cloudflare-turn-api-token>
# DISABLE_PUBLIC_TURN=true
#
# OPTION B — Self-hosted coturn (infra/coturn/docker-compose.yml)
# Best for full control / corporate proxy traversal via TLS-on-443.
# TURN_HOST=turn.example.com                   # public DNS / IP of your coturn box
# TURN_STATIC_AUTH_SECRET=use-openssl-rand-32  # MUST match coturn's static-auth-secret
# TURN_USE_TLS_443=true                        # advertise turns://host:443 (corporate proxies)
# DISABLE_PUBLIC_TURN=true
# TURN_PORT_UDP=3478
# TURN_PORT_TCP=3478
# TURN_PORT_TLS=5349
# TURN_TTL_SECONDS=43200                       # ephemeral creds lifetime (12h)
#
# OPTION C — Static credentials (legacy / Twilio-style providers)
# TURN_SERVER_URL=turn:turn.example.com:3478
# TURN_SERVER_USERNAME=workpulse
# TURN_SERVER_CREDENTIAL=changeme
#
# OPTIONAL — STUN customisation (defaults to Google + Cloudflare public STUN)
# STUN_HOSTS=stun:stun1.l.google.com:19302,stun:stun.cloudflare.com:3478
#
# See docs/CALLS.md for full setup, troubleshooting, and the production
# hardening checklist.

# ── HLS large-meeting broadcast (videosdk-hls-style) ──
# When more than ~12 people join a meeting, we switch from a WebRTC mesh
# to a 1-publisher-many-viewers HLS stream. Requires an upstream media
# server that accepts an MP4/WebM ingest and serves HLS. Supported back-ends:
#   ovm       — OvenMediaEngine (recommended for self-host)
#   livekit   — LiveKit + Egress with HLS sink
#   nginx     — nginx-rtmp + ffmpeg sidecar
#   external  — Mux / Cloudflare Stream / AWS IVS
#
# HLS_MEDIA_SERVER=
# HLS_INGEST_BASE_URL=https://media.example.com/ingest
# HLS_PLAYBACK_BASE_URL=https://media.example.com/hls
# HLS_INGEST_TOKEN_SECRET=use-openssl-rand-base64-32
# HLS_BROADCAST_TTL_SECS=14400

# ── Payroll / Salary Disbursement ─────────────────────
# Required for encrypting sensitive data (Razorpay API keys, bank account numbers).
# Generate with: openssl rand -hex 32
# ENCRYPTION_KEY=your-64-char-hex-key
#
# Note: Razorpay credentials and webhook secret are configured per-org
# in the Admin → Payment Settings UI (stored encrypted in the database).

# ── Push Notifications (Firebase Cloud Messaging) ─────
# Required for mobile push notifications (incoming calls, messages, alerts).
# FCM is FREE — no billing needed.
#
# Setup:
#   1. Go to https://console.firebase.google.com/project/aino-86bb6/settings/serviceaccounts/adminsdk
#   2. Click "Generate new private key" → download JSON
#   3. Paste the entire JSON content as a single-line string below
#
# FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"aino-86bb6","private_key_id":"...","private_key":"-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n","client_email":"firebase-adminsdk-xxx@aino-86bb6.iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}

# Optional push tuning for native incoming-call parity.
# PUSH_CALL_TTL_SECONDS=30
# PUSH_CALL_APNS_TOPIC=app.aino.mobile.voip
# PUSH_CALL_APNS_PUSH_TYPE=alert
# PUSH_DEFAULT_ANDROID_CHANNEL=default
