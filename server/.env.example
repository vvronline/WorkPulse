JWT_SECRET=your_jwt_secret_here

# ── Database ──────────────────────────────────────────
# DATABASE_URL=postgresql://user:pass@localhost:5432/workpulse

# ── Email ─────────────────────────────────────────────
# Required for notifications, password reset, etc.
# Two modes supported — set one group or the other:

# MODE 1 — Gmail OAuth2 (recommended, token-based, no password stored)
# See setup guide: https://developers.google.com/identity/protocols/oauth2
# 1. Create OAuth credentials at https://console.cloud.google.com/apis/credentials
# 2. Get a refresh token via OAuth2 Playground (https://developers.google.com/oauthplayground)
SMTP_USER=your-email@gmail.com
GMAIL_CLIENT_ID=your-client-id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your-client-secret
GMAIL_REFRESH_TOKEN=your-refresh-token
SMTP_FROM="WorkPulse" <your-email@gmail.com>

# MODE 2 — Plain SMTP (app-password fallback)
# For Gmail: enable 2FA, then create App Password at https://myaccount.google.com/apppasswords
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM="WorkPulse" <your-email@gmail.com>

# ── CORS ──────────────────────────────────────────────
# CORS_ORIGIN=http://localhost:3000
