JWT_SECRET=your_jwt_secret_here

# ── Database ──────────────────────────────────────────
# DATABASE_URL=postgresql://user:pass@localhost:5432/workpulse

# ── Email (SMTP) ──────────────────────────────────────
# Required for notifications, password reset, etc.
# For Gmail: enable 2FA, then create an App Password at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="WorkPulse" <your-email@gmail.com>

# ── CORS ──────────────────────────────────────────────
# CORS_ORIGIN=http://localhost:3000
