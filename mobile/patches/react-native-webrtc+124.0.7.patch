+package com.oney.WebRTCModule;
+
+import android.content.Context;
+import android.util.Log;
+import android.widget.FrameLayout;
+
+import androidx.core.view.ViewCompat;
+
+import com.facebook.react.bridge.ReactContext;
+
+import org.webrtc.EglBase;
+import org.webrtc.MediaStream;
+import org.webrtc.VideoTrack;
+
+import java.util.List;
+import java.util.Objects;
+
+/**
+ * An RTCView variant backed by a {@link TextureViewRenderer} so the rendered
+ * video honours parent {@code borderRadius} / {@code overflow:hidden}. Intended
+ * for small, rounded local self-view tiles.
+ *
+ * It mirrors the stream -> track -> sink lifecycle of {@code WebRTCView} but
+ * is intentionally additive: the default {@code RTCVideoView} (SurfaceView) is
+ * left completely untouched, so the remote / full-screen video paths keep their
+ * more efficient SurfaceView rendering.
+ *
+ * Note: {@code ThreadUtils} below resolves to the package-local
+ * {@code com.oney.WebRTCModule.ThreadUtils} (which exposes {@code runOnExecutor})
+ * and intentionally not {@code org.webrtc.ThreadUtils}.
+ */
+public class RTCTextureView extends FrameLayout {
+    private static final String TAG = WebRTCModule.TAG;
+
+    private final TextureViewRenderer renderer;
+    private String streamURL;
+    private VideoTrack videoTrack;
+    private boolean rendererAttached = false;
+    private boolean mirror = false;
+
+    public RTCTextureView(Context context) {
+        super(context);
+        renderer = new TextureViewRenderer(context);
+        addView(renderer,
+                new FrameLayout.LayoutParams(
+                        FrameLayout.LayoutParams.MATCH_PARENT, FrameLayout.LayoutParams.MATCH_PARENT));
+    }
+
+    public void setMirror(boolean mirror) {
+        this.mirror = mirror;
+        renderer.setMirror(mirror);
+    }
+
+    public void setObjectFit(String objectFit) {
+        // "cover" is handled by the renderer's aspect-fill cropping. The prop is
+        // accepted for parity with RTCView; "contain" is not required for the
+        // rounded self-view tile.
+    }
+
+    public void setZOrder(int zOrder) {
+        // No-op: a TextureView composites inside the view hierarchy, so the
+        // SurfaceView z-order/overlay modes do not apply.
+    }
+
+    private VideoTrack getVideoTrackForStreamURL(String streamURL) {
+        VideoTrack track = null;
+
+        if (streamURL != null) {
+            ReactContext reactContext = (ReactContext) getContext();
+            WebRTCModule module = reactContext.getNativeModule(WebRTCModule.class);
+            MediaStream stream = module.getStreamForReactTag(streamURL);
+
+            if (stream != null) {
+                List<VideoTrack> videoTracks = stream.videoTracks;
+                if (!videoTracks.isEmpty()) {
+                    track = videoTracks.get(0);
+                }
+            }
+
+            if (track == null) {
+                Log.w(TAG, "No video stream for react tag: " + streamURL);
+            }
+        }
+
+        return track;
+    }
+
+    public void setStreamURL(String streamURL) {
+        if (!Objects.equals(streamURL, this.streamURL)) {
+            VideoTrack track = getVideoTrackForStreamURL(streamURL);
+
+            if (this.videoTrack != track) {
+                setVideoTrack(null);
+            }
+
+            this.streamURL = streamURL;
+            setVideoTrack(track);
+        }
+    }
+
+    private void setVideoTrack(VideoTrack track) {
+        VideoTrack oldVideoTrack = this.videoTrack;
+
+        if (oldVideoTrack != track) {
+            if (oldVideoTrack != null) {
+                removeRendererFromVideoTrack();
+            }
+
+            this.videoTrack = track;
+
+            if (track != null) {
+                tryAddRendererToVideoTrack();
+            }
+        }
+    }
+
+    private void tryAddRendererToVideoTrack() {
+        if (!rendererAttached && videoTrack != null && ViewCompat.isAttachedToWindow(this)) {
+            EglBase.Context sharedContext = EglUtils.getRootEglBaseContext();
+
+            if (sharedContext == null) {
+                Log.e(TAG, "Failed to render a VideoTrack: no root EGL context");
+                return;
+            }
+
+            renderer.init(sharedContext);
+            renderer.setMirror(mirror);
+
+            final VideoTrack track = videoTrack;
+            ThreadUtils.runOnExecutor(() -> {
+                try {
+                    track.addSink(renderer);
+                } catch (Throwable tr) {
+                    // The track may already have been released on the JS side.
+                    Log.e(TAG, "Failed to add renderer", tr);
+                }
+            });
+
+            rendererAttached = true;
+        }
+    }
+
+    private void removeRendererFromVideoTrack() {
+        if (rendererAttached) {
+            final VideoTrack track = videoTrack;
+            if (track != null) {
+                ThreadUtils.runOnExecutor(() -> {
+                    try {
+                        track.removeSink(renderer);
+                    } catch (Throwable tr) {
+                        // Already released — safe to ignore.
+                    }
+                });
+            }
+
+            renderer.release();
+            rendererAttached = false;
+        }
+    }
+
+    @Override
+    protected void onAttachedToWindow() {
+        super.onAttachedToWindow();
+        tryAddRendererToVideoTrack();
+    }
+
+    @Override
+    protected void onDetachedFromWindow() {
+        removeRendererFromVideoTrack();
+        super.onDetachedFromWindow();
+    }
+}
