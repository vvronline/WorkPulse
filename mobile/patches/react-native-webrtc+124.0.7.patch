@@ -0,0 +1,44 @@
+package com.oney.WebRTCModule;
+
+import com.facebook.react.uimanager.SimpleViewManager;
+import com.facebook.react.uimanager.ThemedReactContext;
+import com.facebook.react.uimanager.annotations.ReactProp;
+
+/**
+ * ViewManager for {@link RTCTextureView}. Exposes the same JS props as the
+ * default {@code RTCVideoView} (streamURL / mirror / objectFit / zOrder) so it
+ * is a drop-in replacement where rounded corners are required.
+ */
+public class RTCTextureViewManager extends SimpleViewManager<RTCTextureView> {
+    private static final String REACT_CLASS = "RTCTextureView";
+
+    @Override
+    public String getName() {
+        return REACT_CLASS;
+    }
+
+    @Override
+    public RTCTextureView createViewInstance(ThemedReactContext context) {
+        return new RTCTextureView(context);
+    }
+
+    @ReactProp(name = "mirror")
+    public void setMirror(RTCTextureView view, boolean mirror) {
+        view.setMirror(mirror);
+    }
+
+    @ReactProp(name = "objectFit")
+    public void setObjectFit(RTCTextureView view, String objectFit) {
+        view.setObjectFit(objectFit);
+    }
+
+    @ReactProp(name = "streamURL")
+    public void setStreamURL(RTCTextureView view, String streamURL) {
+        view.setStreamURL(streamURL);
+    }
+
+    @ReactProp(name = "zOrder")
+    public void setZOrder(RTCTextureView view, int zOrder) {
+        view.setZOrder(zOrder);
+    }
+}
diff --git a/android/src/main/java/com/oney/WebRTCModule/TextureViewRenderer.java b/android/src/main/java/com/oney/WebRTCModule/TextureViewRenderer.java
new file mode 100644
index 0000000..7f9f3c8
--- /dev/null
+++ b/android/src/main/java/com/oney/WebRTCModule/TextureViewRenderer.java
@@ -0,0 +1,124 @@
+package com.oney.WebRTCModule;
+
+import android.content.Context;
+import android.graphics.SurfaceTexture;
+import android.util.AttributeSet;
+import android.view.TextureView;
+
+import org.webrtc.EglBase;
+import org.webrtc.EglRenderer;
+import org.webrtc.GlRectDrawer;
+import org.webrtc.VideoFrame;
+import org.webrtc.VideoSink;
+
+import java.util.concurrent.CountDownLatch;
+
+/**
+ * A TextureView-based WebRTC video renderer.
+ *
+ * The default RTCView renders through a {@code SurfaceViewRenderer}, which draws
+ * onto a dedicated hardware overlay. Because that overlay lives outside the
+ * normal view hierarchy, parent {@code borderRadius} / {@code overflow:hidden} /
+ * opacity are ignored and the corners always stay square.
+ *
+ * A {@link TextureView} is an ordinary view in the hierarchy, so it can be
+ * clipped to rounded corners (and faded) like any other view. This is a Java
+ * port of GetStream's {@code VideoTextureViewRenderer} (Apache-2.0), trimmed to
+ * the aspect-fill ("cover") behaviour the rounded self-view tile needs.
+ */
+public class TextureViewRenderer extends TextureView implements VideoSink, TextureView.SurfaceTextureListener {
+    private final EglRenderer eglRenderer;
+    private boolean rendererInitialized = false;
+
+    public TextureViewRenderer(Context context) {
+        this(context, null);
+    }
+
+    public TextureViewRenderer(Context context, AttributeSet attrs) {
+        super(context, attrs);
+        this.eglRenderer = new EglRenderer("TextureViewRenderer");
+        setSurfaceTextureListener(this);
+        // Allow the clipped/rounded parent and any background to show through
+        // until the first frame arrives.
+        setOpaque(false);
+    }
+
+    public synchronized void init(EglBase.Context sharedContext) {
+        if (rendererInitialized) {
+            return;
+        }
+        eglRenderer.init(sharedContext, EglBase.CONFIG_PLAIN, new GlRectDrawer());
+        rendererInitialized = true;
+        // The SurfaceTexture may already be available if init() runs after the
+        // view was laid out; bind to it immediately so rendering can start.
+        if (isAvailable()) {
+            SurfaceTexture surfaceTexture = getSurfaceTexture();
+            if (surfaceTexture != null) {
+                eglRenderer.createEglSurface(surfaceTexture);
+            }
+        }
+    }
+
+    public void setMirror(boolean mirror) {
+        eglRenderer.setMirror(mirror);
+    }
+
+    public synchronized void release() {
+        if (!rendererInitialized) {
+            return;
+        }
+        rendererInitialized = false;
+        eglRenderer.release();
+    }
+
+    @Override
+    public void onFrame(VideoFrame frame) {
+        eglRenderer.onFrame(frame);
+    }
+
+    @Override
+    protected void onLayout(boolean changed, int left, int top, int right, int bottom) {
+        super.onLayout(changed, left, top, right, bottom);
+        int width = right - left;
+        int height = bottom - top;
+        if (width > 0 && height > 0) {
+            // Driving the layout aspect ratio makes the EglRenderer crop the
+            // frame to fill the view (object-fit: cover) instead of stretching.
+            eglRenderer.setLayoutAspectRatio(width / (float) height);
+        }
+    }
+
+    @Override
+    public void onSurfaceTextureAvailable(SurfaceTexture surface, int width, int height) {
+        synchronized (this) {
+            if (rendererInitialized) {
+                eglRenderer.createEglSurface(surface);
+            }
+        }
+    }
+
+    @Override
+    public boolean onSurfaceTextureDestroyed(SurfaceTexture surface) {
+        synchronized (this) {
+            if (rendererInitialized) {
+                final CountDownLatch latch = new CountDownLatch(1);
+                // Passing null here NPEs in the bundled WebRTC fork, so always
+                // hand it a real completion callback and wait for the surface to
+                // be released before the SurfaceTexture is torn down.
+                eglRenderer.releaseEglSurface(latch::countDown);
+                try {
+                    latch.await();
+                } catch (InterruptedException e) {
+                    Thread.currentThread().interrupt();
+                }
+            }
+        }
+        return true;
+    }
+
+    @Override
+    public void onSurfaceTextureSizeChanged(SurfaceTexture surface, int width, int height) {}
+
+    @Override
+    public void onSurfaceTextureUpdated(SurfaceTexture surface) {}
+}
