<!--
  WorkPulse notification SMALL icon — a MONOCHROME (white-on-transparent)
  silhouette of the WorkPulse brand mark (the "pulse" star core with an orbiting
  planet), derived from desktop/icons/icon.svg.

  WHY MONOCHROME: Android renders the notification status-bar small icon as a
  flat, single-color silhouette (the OS discards color and tints it). It MUST be
  a static compile-time drawable; a notification posted with no resolvable small
  icon is dropped silently. This replaces the previous generic chat-bubble glyph
  with the brand mark while satisfying that constraint. The full-color per-org
  branding logo still shows as the large (round) notification image.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- Central pulse core (the star) -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M12,8.9 A3.1,3.1 0 1,0 12,15.1 A3.1,3.1 0 1,0 12,8.9 Z" />
    <!-- Pulse ring around the core -->
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="0.9"
        android:fillColor="#00000000"
        android:pathData="M12,6.3 A5.7,5.7 0 1,0 12,17.7 A5.7,5.7 0 1,0 12,6.3 Z" />
    <!-- Tilted orbit + planet (rotated as a group) -->
    <group
        android:name="orbit"
        android:pivotX="12"
        android:pivotY="12"
        android:rotation="-20">
        <path
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="0.9"
            android:fillColor="#00000000"
            android:pathData="M4,12 A8,3.5 0 1,0 20,12 A8,3.5 0 1,0 4,12 Z" />
        <path
            android:fillColor="#FFFFFFFF"
            android:pathData="M20,12 m-1.7,0 a1.7,1.7 0 1,0 3.4,0 a1.7,1.7 0 1,0 -3.4,0" />
    </group>
</vector>