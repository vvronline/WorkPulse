{
  // Type-checks the jest test suites (which the app tsconfig excludes). Adds the
  // jest + node globals the tests rely on. Run via `npm run typecheck:tests`.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["jest", "node"]
  },
  "include": ["**/__tests__/**/*.ts", "**/__tests__/**/*.tsx", "jest.setup.js"],
  "exclude": ["node_modules", "android", "ios", ".expo"]
}
