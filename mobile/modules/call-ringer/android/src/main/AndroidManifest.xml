<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!--
    CallRingService — a SHORT-LIVED foreground service that drives the
    incoming-call ring (looping MediaPlayer on the user's selected ringtone) and
    a repeating Vibrator, fully app-controlled, in EVERY app state (foreground,
    background, locked, killed). This mirrors how Signal/Teams ring on Android:
    they do NOT rely on the notification channel sound (which is fixed/immutable)
    but run a foreground service so the ring is consistent and stops the instant
    the call is answered/declined.

    foregroundServiceType="phoneCall" is required on Android 10+ (API 29) for a
    call-related FGS. The matching FOREGROUND_SERVICE_PHONE_CALL runtime
    permission is already declared in app.config.ts's android.permissions.
  -->
  <application>
    <service
      android:name="expo.modules.callringer.CallRingService"
      android:exported="false"
      android:foregroundServiceType="phoneCall" />
    <!--
      ActiveCallService — the ONGOING-CALL foreground service that runs for the
      lifetime of a connected call (Signal ActiveCallManager model). It keeps the
      process at foreground priority so the OS does not throttle the app mid-call,
      which would surface as video stutter/lag/freeze. Declared with the
      microphone|camera foreground-service types (the call uses the mic always
      and the camera on video calls). The matching FOREGROUND_SERVICE_MICROPHONE
      / FOREGROUND_SERVICE_CAMERA runtime permissions are declared in
      app.config.ts's android.permissions.
    -->
    <service
      android:name="expo.modules.callringer.ActiveCallService"
      android:exported="false"
      android:foregroundServiceType="microphone|camera" />
    <!--
      Transparent TRAMPOLINE activity that handles the Answer/Decline action-
      button taps from the CallStyle incoming-call notification. The notification
      actions target it via PendingIntent.getActivity() — NOT a BroadcastReceiver
      — because a background BroadcastReceiver cannot reliably startActivity() on
      Android 10+ (background-activity-start restrictions), which caused "Answer
      stops the ring but the call screen never opens; I have to open the app
      manually". An Activity launched by a notification action is foreground-
      privileged and reliably brings the call/video screen forward in every app
      state. It records the choice + deep-links into the JS call screen, then
      finishes immediately (it has no UI). showWhenLocked/turnScreenOn let
      answering work over the lock screen; the translucent theme keeps it
      invisible. Not exported (only our own PendingIntents target it).
    -->
    <activity
      android:name="expo.modules.callringer.CallActionActivity"
      android:exported="false"
      android:excludeFromRecents="true"
      android:launchMode="singleTop"
      android:noHistory="true"
      android:showWhenLocked="true"
      android:turnScreenOn="true"
      android:taskAffinity=""
      android:theme="@android:style/Theme.Translucent.NoTitleBar" />
  </application>
</manifest>