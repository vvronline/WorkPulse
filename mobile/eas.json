{
  "cli": {
    "version": ">= 5.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://workpulse-prod.up.railway.app/api",
        "EXPO_PUBLIC_WS_BASE_URL": "wss://workpulse-prod.up.railway.app"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://workpulse-prod.up.railway.app/api",
        "EXPO_PUBLIC_WS_BASE_URL": "wss://workpulse-prod.up.railway.app"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://workpulse-prod.up.railway.app/api",
        "EXPO_PUBLIC_WS_BASE_URL": "wss://workpulse-prod.up.railway.app"
      }
    }
  },
  "submit": {
    "production": {}
  }
}